# Copie para .env e ajuste:  cp .env.example .env
# O .env esta no .gitignore e nunca vai para o repositorio.

DB_NAME=teste_pratico
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
API_PORT=8080

# HS256 exige no minimo 32 bytes. Gere o seu com:
#   openssl rand -base64 48
# Em producao isso viria de um secret manager, nunca de arquivo.
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio-de-48-bytes
JWT_EXPIRACAO_MINUTOS=120

CORS_ORIGENS=http://localhost:5173
