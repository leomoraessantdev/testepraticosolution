# URL do backend. Sem barra no final.
#
# O frontend fala direto com a API, sem proxy do Vite, de proposito: assim o
# navegador executa o preflight de CORS de verdade e exercita a configuracao
# app.cors.origens do backend. Um proxy esconderia um CORS mal configurado,
# que so apareceria em producao.
VITE_API_URL=http://localhost:8080
